# Copy to backend/.env and supply values locally. Never commit backend/.env.
ORS_API_KEY=
DJANGO_SECRET_KEY=
DJANGO_DEBUG=
DJANGO_ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=
GEOCODING_USER_AGENT=
# Optional provider URLs; leave blank to use the documented defaults.
ORS_BASE_URL=
OSRM_BASE_URL=
NOMINATIM_BASE_URL=
# Opt in only after reading the Nominatim usage restrictions in README.md.
NOMINATIM_ENABLED=
